{
    "name": "roadrunner/cli",
    "type": "library",
    "description": "RoadRunner command-line tool: downloads the RoadRunner binary and generates its configuration",
    "keywords": [
        "roadrunner",
        "cli",
        "console",
        "installer",
        "binary",
        "download"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Anton Titov",
            "homepage": "https://github.com/wolfy-j"
        },
        {
            "name": "RoadRunner Community",
            "homepage": "https://github.com/roadrunner-server/roadrunner/graphs/contributors"
        }
    ],
    "bin": [
        "bin/rr"
    ],
    "homepage": "https://roadrunner.dev/",
    "support": {
        "docs": "https://docs.roadrunner.dev/docs/general/install",
        "issues": "https://github.com/roadrunner-server/roadrunner/issues",
        "source": "https://github.com/roadrunner-php/cli",
        "chat": "https://discord.gg/V6EK4he"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/roadrunner-server"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "composer-runtime-api": "^2.0",
        "composer/semver": "^3.4",
        "roadrunner/worker": "^3.8",
        "spiral/tokenizer": "^2.13 || ^3.15",
        "symfony/console": "^5.3 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-client": "^4.4.51 || ^5.4.49 || ^6.4.17 || ^7.2 || ^8.0",
        "symfony/yaml": "^5.4.49 || ^6.4.17 || ^7.2 || ^8.0"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.2",
        "spiral/code-style": "^2.3.1",
        "spiral/dumper": "^3.3",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "replace": {
        "spiral/roadrunner-cli": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\RoadRunner\\Console\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\RoadRunner\\Console\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "test": "vendor/bin/testo"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "GHSA-g9pc-8g42-g6vq": "False positive: the range < 2025.1.0 also matches RoadRunner 3.x, which is not affected"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
